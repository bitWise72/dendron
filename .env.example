# Dendron Demo Environment Variables Template
# Copy these to Vercel Dashboard → Settings → Environment Variables

# Provider configuration
DENDRON_PROVIDER=gemini
DENDRON_MODEL=gemini-3.1-flash-preview

# Primary Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback API Keys (optional, but recommended for load balancing)
GEMINI_API_KEY_1=your_gemini_fallback_key_1
GEMINI_API_KEY_2=your_gemini_fallback_key_2
GEMINI_API_KEY_3=your_gemini_fallback_key_3
GEMINI_API_KEY_4=your_gemini_fallback_key_4
GEMINI_API_KEY_5=your_gemini_fallback_key_5

# CORS Settings
# Comma-separated list of allowed origins, or "*" for all
ALLOWED_ORIGINS=https://dendron-landing-page.vercel.app,https://yoursite.com

# Example usage:
# ALLOWED_ORIGINS=*                                    (allow all - not recommended for production)
# ALLOWED_ORIGINS=https://site1.com,https://site2.com (whitelist specific domains)
